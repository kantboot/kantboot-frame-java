            <version>${revision}</version>
        </dependency>

        <dependency>
            <groupId>com.kantboot</groupId>
            <artifactId>util-admin</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- 基础控制器模块（util-base-control）：提供基础的控制器功能和通用的请求处理逻辑 -->
        <dependency>
            <groupId>com.kantboot</groupId>
            <artifactId>util-base-control</artifactId>
            <version>${revision}</version>
