        <dependency>
            <groupId>com.kantboot</groupId>
            <artifactId>util-setting</artifactId>
            <version>${revision}</version>
        </dependency>
        <!-- JPA 工具模块（util-jpa）：提供 JPA 相关功能 -->
        <dependency>
            <groupId>com.kantboot</groupId>
            <artifactId>util-jpa</artifactId>
            <version>${revision}</version>
        </dependency>
